programa {
  funcao inicio() {
    para(inteiro i = 0; i <= 5; i++)
    {
      escreva(i, "\n")
    }
    
    escreva("===\n")

    inteiro n = 0
    enquanto(n <= 5)
    {
      escreva(n, "\n")
      n++
    }

    escreva("===\n")

    inteiro a = 0
    faca 
    {
      escreva(a, "\n")
      a++
    } 
    enquanto(a <= 5)
  }
}